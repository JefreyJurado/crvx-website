---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import Silhouette from '../components/Silhouette.astro';
import { MEMBERS, DEMO_MEMBERS, VOICES, CHOIR_MASTER } from '../data/members';

// Demo cards only on Vercel PREVIEW builds or with MEMBERS_DEMO=1 locally.
// Fails closed: production, or a build where VERCEL_ENV is unset, shows real data only.
const vercelEnv = import.meta.env.VERCEL_ENV ?? process.env.VERCEL_ENV;
const showDemo = vercelEnv === 'preview' || process.env.MEMBERS_DEMO === '1';

// Consent filter at BUILD time: non-consented entries never reach the HTML.
const members = [...MEMBERS, ...(showDemo ? DEMO_MEMBERS : [])].filter(m => m.consented === true);
const organists = members.filter(m => m.voice === 'Organist');
const sections = VOICES.map(voice => ({ voice, people: members.filter(m => m.voice === voice) }))
  .filter(s => s.people.length > 0);

---
<Base title="Our Members" description="The singers of Crvx et Cithara, grouped by voice part, introduced with their consent.">
  <section class="section dark page-head">
    <div class="container section-head centered">
      <p class="eyebrow">The people</p>
      <h1 class="title">Our Members</h1>
    </div>
  </section>

  <section class="section">
    <div class="container stack lg">
      <section class="voice" aria-labelledby="v-direction">
        <h2 id="v-direction" class="title voice-h">Music Direction</h2>
        <ul class="direction">
          <li class="card m-card featured">
            <div class="frame"><Silhouette /></div>
            <h3 class="m-name">{CHOIR_MASTER.name}</h3>
            <p class="m-role">{CHOIR_MASTER.role}</p>
          </li>
          {organists.map(m => (
            <li class="card m-card featured">
              <div class="frame">{m.photo
                ? <Image class="m-photo" src={m.photo} alt={`Portrait of ${m.name}`} widths={[260, 520]} sizes="260px" format="webp" quality={75} />
                : <Silhouette />}</div>
              <h3 class="m-name">{m.name}</h3>
              <p class="m-role">Organist</p>
            </li>
          ))}
        </ul>
      </section>

      {sections.length === 0 ? (
        <p class="empty">Our members will be introduced here soon, each with their consent.</p>
      ) : sections.map(s => (
        <section class="voice" aria-labelledby={`v-${s.voice}`}>
          <h2 id={`v-${s.voice}`} class="title voice-h">{s.voice}</h2>
          <ul class="grid">
            {s.people.map(m => (
              <li class="card m-card">
                <div class="frame">{m.photo
                  ? <Image class="m-photo" src={m.photo} alt={`Portrait of ${m.name}`} widths={[240, 480]} sizes="240px" format="webp" quality={75} />
                  : <Silhouette />}</div>
                <h3 class="m-name">{m.name}</h3>
                <p class="m-role">{m.voice}</p>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>
</Base>

<style>
  .page-head { padding: 56px 0; }
  .m-card {
    text-align: center; align-items: center;
    box-shadow: 0 6px 18px rgb(24 29 25 / 0.08);
  }
  /* Music Direction: Choir Master alone is centred; organists sit beside him, stacking on phones. */
  .direction { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 24px; }
  .featured { flex: 0 1 420px; min-width: 0; padding: 36px 32px; }
  /* Liturgical niche (owner): a 4:5 portrait with a round Romanesque arch, a double
     Antique Gold border (outer line + inner hairline 4px in, like an icon frame) and a
     small keystone dot. The photo or silhouette fills the inner arch; faces sit at 50% 22%. */
  .frame {
    --arch: 50% 50% 4px 4px / 32% 32% 4px 4px;
    position: relative; width: 100%; max-width: 240px; aspect-ratio: 4 / 5; flex: none;
    padding: 4px; border: 1px solid var(--antique-gold); border-radius: var(--arch);
    background: var(--card-parchment);
  }
  .featured .frame { max-width: 260px; }
  .frame::before {
    content: ''; position: absolute; top: -4px; left: 50%; transform: translateX(-50%);
    width: 7px; height: 7px; border-radius: 50%; background: var(--antique-gold);
  }
  .frame > :global(.silhouette), .frame > :global(.m-photo) {
    display: block; width: 100%; height: 100%;
    border: 1px solid rgb(180 154 104 / 0.7); border-radius: var(--arch); overflow: hidden;
  }
  .frame > :global(.m-photo) { object-fit: cover; object-position: 50% 22%; }
  .m-name { font-family: var(--font-display); font-size: 20px; color: var(--deep-forest); margin-top: 4px; }
  .featured .m-name { font-size: 22px; }
  .m-role { font-size: 13px !important; letter-spacing: 0.12em; text-transform: uppercase; color: var(--deep-gold) !important; }
  .empty { text-align: center; font-family: var(--font-accent); font-style: italic; font-size: 22px; color: var(--muted-on-parchment); }

  .voice { display: flex; flex-direction: column; gap: 24px; }
  .voice-h { text-align: center; }
  /* 4 / 3 / 2 / 1 columns; a short last row stays centred. */
  .grid { --cols: 4; --gap: 24px; list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: var(--gap); }
  .grid > li { flex: 0 1 calc((100% - (var(--cols) - 1) * var(--gap)) / var(--cols)); min-width: 0; }
  @media (max-width: 1100px) { .grid { --cols: 3; } }
  @media (max-width: 820px) { .grid { --cols: 2; } }
  @media (max-width: 520px) { .grid { --cols: 1; } .grid > li { max-width: 360px; } }
</style>
