---
import Base from '../layouts/Base.astro';
import NicheFrame from '../components/NicheFrame.astro';
import GroupFrame from '../components/GroupFrame.astro';
import { MEMBERS, DEMO_MEMBERS, VOICES, CHOIR_MASTER, GROUP_PHOTO, SHOW_DEMO } from '../data/members';

const showDemo = SHOW_DEMO;
// Group photo: only with everyone's consent; otherwise a 'Group photo coming soon' placeholder.
const group = GROUP_PHOTO?.consented === true ? GROUP_PHOTO : undefined;

// Consent filter at BUILD time: non-consented entries never reach the HTML.
const members = [...MEMBERS, ...(showDemo ? DEMO_MEMBERS : [])].filter(m => m.consented === true);
const organists = members.filter(m => m.voice === 'Organist');
// Every voice section always shows. One with no consented members shows 4 decorative
// 'Coming soon' cards instead; as soon as one real member is added, only real members show.
const PLACEHOLDERS = 4;
const sections = VOICES.map(voice => ({ voice, people: members.filter(m => m.voice === voice) }));

---
<Base title="Our Members" description="The singers of Crvx et Cithara, grouped by voice part, introduced with their consent.">
  <section class="section dark page-head">
    <div class="container section-head centered">
      <p class="eyebrow">The people</p>
      <h1 class="title">Our Members</h1>
    </div>
  </section>

  <section class="section">
    <div class="container stack lg">
      {members.length === 0 && <p class="intro">Our members will be introduced here, each with their consent.</p>}
      <div class="group-wrap"><GroupFrame photo={group} caption={group ? 'Crvx et Cithara' : 'Group photo coming soon'} /></div>
      <section class="voice" aria-labelledby="v-direction">
        <h2 id="v-direction" class="title voice-h">Music Direction</h2>
        <ul class="direction">
          <li class="card m-card featured">
            <NicheFrame sizes="260px" />
            <h3 class="m-name">{CHOIR_MASTER.name}</h3>
            <p class="m-role">Choir Master</p>
          </li>
          {organists.map(m => (
            <li class="card m-card featured">
              <NicheFrame photo={m.photo} alt={`Portrait of ${m.name}`} sizes="260px" />
              <h3 class="m-name">{m.name}</h3>
              <p class="m-role">Organist</p>
            </li>
          ))}
          {organists.length === 0 && (
            <li class="card m-card featured coming" aria-hidden="true">
              <NicheFrame sizes="260px" />
              <h3 class="m-name">Coming soon</h3>
              <p class="m-role">Organist</p>
            </li>
          )}
        </ul>
        {organists.length === 0 && <p class="visually-hidden">Organist coming soon</p>}
      </section>

      {sections.map(s => (
        <section class="voice" aria-labelledby={`v-${s.voice}`}>
          <h2 id={`v-${s.voice}`} class="title voice-h">{s.voice}</h2>
          <ul class="grid">
            {s.people.map(m => (
              <li class="card m-card">
                <NicheFrame photo={m.photo} alt={`Portrait of ${m.name}`} sizes="240px" />
                <h3 class="m-name">{m.name}</h3>
                <p class="m-role">{m.voice}</p>
              </li>
            ))}
            {s.people.length === 0 && Array.from({ length: PLACEHOLDERS }, () => (
              <li class="card m-card coming" aria-hidden="true">
                <NicheFrame sizes="240px" />
                <h3 class="m-name">Coming soon</h3>
                <p class="m-role">{s.voice}</p>
              </li>
            ))}
          </ul>
          {s.people.length === 0 && <p class="visually-hidden">Members coming soon</p>}
        </section>
      ))}
    </div>
  </section>
</Base>

<style>
  .page-head { padding: 56px 0; }
  .group-wrap { width: 100%; max-width: 1000px; margin: 0 auto; }
  .m-card {
    text-align: center; align-items: center;
    box-shadow: 0 6px 18px rgb(24 29 25 / 0.08);
  }
  /* Music Direction: Choir Master alone is centred; organists sit beside him, stacking on phones. */
  .direction { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 24px; }
  .featured { flex: 0 1 420px; min-width: 0; padding: 36px 32px; }
  /* Frame design lives in NicheFrame (gilded icon, owner's pick). */
  .m-card :global(.niche) { max-width: 240px; }
  .featured :global(.niche) { max-width: 260px; }
  .m-name { font-family: var(--font-display); font-size: 20px; color: var(--deep-forest); margin-top: 4px; }
  .featured .m-name { font-size: 22px; }
  .m-role { font-size: 13px !important; letter-spacing: 0.12em; text-transform: uppercase; color: var(--deep-gold) !important; }
  .intro { text-align: center; font-family: var(--font-accent); font-style: italic; font-size: 22px; color: var(--muted-on-parchment); }
  .coming .m-name { color: var(--muted-on-parchment); font-style: normal; }

  .voice { display: flex; flex-direction: column; gap: 24px; }
  .voice-h { text-align: center; }
  /* 4 / 3 / 2 / 1 columns; a short last row stays centred. */
  .grid { --cols: 4; --gap: 24px; list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: var(--gap); }
  .grid > li { flex: 0 1 calc((100% - (var(--cols) - 1) * var(--gap)) / var(--cols)); min-width: 0; }
  @media (max-width: 1100px) { .grid { --cols: 3; } }
  @media (max-width: 820px) { .grid { --cols: 2; } }
  /* Exactly 4 cards (e.g. the placeholders) at 3 columns would leave a lone card (3+1): use 2+2 (Jomar). */
  @media (min-width: 821px) and (max-width: 1100px) { .grid:has(> li:nth-child(4):last-child) { --cols: 2; } }
  @media (max-width: 520px) { .grid { --cols: 1; } .grid > li { max-width: 360px; } }
</style>
