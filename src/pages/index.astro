---
import Base from '../layouts/Base.astro';
import { Image, getImage } from 'astro:assets';
import heroImg from '../assets/images/hero-baclayon.jpg';
import aboutImg from '../assets/images/about-organ-lyre.jpg';
import manuscriptImg from '../assets/images/manuscript-gradual.jpg';
import { SITE, ENGAGEMENTS, FEATURED, MISSION, VISION, FORMATIONS, OCCASIONS, ABOUT_PARAGRAPHS } from '../data/site';
// Faint chant-manuscript texture behind "Our Voices" (PLAN §5 visual elements).
const manuscript = await getImage({ src: manuscriptImg, width: 900, format: 'webp', quality: 60 });
---
<Base description={SITE.description}>
  <!-- Hero -->
  <section class="hero dark">
    <Image class="hero-bg" src={heroImg} alt="" widths={[640, 960, 1400, 1920, 2400]} sizes="100vw" loading="eager" fetchpriority="high" format="webp" quality={70} />
    <div class="container hero-inner">
      <img class="hero-crest" src="/crest/crest-150.png" srcset="/crest/crest-150.png 1x, /crest/crest-300.png 2x" width="121" height="150" alt="The crest of Crvx et Cithara" />
      <p class="motto">{SITE.motto}</p>
      <h1>{SITE.wordmark}</h1>
      <p class="subtitle">{SITE.subtitle}</p>
      <hr class="gold-rule" />
      <p class="headline">{SITE.headline}</p>
      <p class="positioning">{SITE.positioning}</p>
      <div class="ctas">
        <a class="btn btn-gold" href="/contact#invite" data-open-invite>Invite Us to Sing</a>
        <a class="btn btn-outline-dark" href="/about">Learn About Us</a>
      </div>
    </div>
  </section>

  <!-- Where we sing next -->
  <section class="section tight ruled" aria-labelledby="next-h">
    <div class="container stack">
      <h2 id="next-h" class="label-caps">WHERE WE SING NEXT</h2>
      <ul class="engagements">
        {ENGAGEMENTS.map(ev => (
          <li>
            <span class="when"><span class="day">{ev.day}</span><span class="month">{ev.month}</span></span>
            <span class="what"><span class="occ">{ev.occasion}</span><span class="venue">{ev.venue}</span></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- About -->
  <section class="section">
    <div class="container about-row">
      <div class="stack about-text">
        <p class="eyebrow">Who we are</p>
        <h2 class="title">About Crvx et Cithara</h2>
        <p>{ABOUT_PARAGRAPHS[0]}</p>
        <p>{ABOUT_PARAGRAPHS[2]}</p>
        <a class="more" href="/about">Read our story →</a>
      </div>
      <Image class="about-img" src={aboutImg} alt="A choir-loft pipe organ crowned with a gilded lyre" widths={[480, 800, 1200]} sizes="(max-width: 860px) 100vw, 480px" format="webp" quality={72} />
    </div>
  </section>

  <!-- Mission & Vision -->
  <section class="section dark">
    <div class="container stack lg">
      <h2 class="title" style="text-align:center">MISSION &amp; VISION</h2>
      <div class="row">
        <div class="card-outline-dark"><h3>Our Mission</h3><p>{MISSION}</p></div>
        <div class="card-outline-dark"><h3>Our Vision</h3><p>{VISION}</p></div>
      </div>
    </div>
  </section>

  <!-- Formations -->
  <section class="section ruled textured" style={`--manuscript: url(${manuscript.src})`}>
    <div class="container stack lg">
      <div class="section-head centered">
        <p class="eyebrow">Two formations, one purpose</p>
        <h2 class="title">Our Voices</h2>
      </div>
      <div class="row">
        {FORMATIONS.map(f => (
          <div class="card-dark"><h3>{f.name}</h3><p class="voices">{f.voices}</p><p>{f.short}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- Ministry + occasions -->
  <section class="section">
    <div class="container stack lg">
      <div class="section-head centered">
        <p class="eyebrow">How we serve</p>
        <h2 class="title">Our Ministry</h2>
        <p class="lead">{ABOUT_PARAGRAPHS[1]}</p>
      </div>
      <div class="row">
        <div class="card">
          <h3>Traditional Latin Mass</h3>
          <p>Gregorian chant and sacred polyphony sung for the usus antiquior, in continuity with centuries of the Church's liturgical music.</p>
        </div>
        <div class="card">
          <h3>Novus Ordo</h3>
          <p>Traditional hymns and liturgical music that elevate the ordinary form of the Mass, in parishes and special celebrations.</p>
        </div>
      </div>
      <ul class="chips" aria-label="Occasions we sing for">
        {OCCASIONS.slice(0, 6).map(o => <li>{o}</li>)}
      </ul>
      <p class="repertoire">Our repertoire: Gregorian chant · sacred polyphony · traditional hymns</p>
      <a class="more" href="/ministry" style="align-self:center">More about our ministry →</a>
    </div>
  </section>

  <!-- Featured activities (PLAN §4) -->
  <section class="section ruled" aria-labelledby="featured-h">
    <div class="container stack lg">
      <div class="section-head centered">
        <p class="eyebrow">Recent and upcoming</p>
        <h2 id="featured-h" class="title">Featured Activities</h2>
      </div>
      <ul class="featured">
        {FEATURED.map(f => (
          <li>
            <div class="ph r32">[ EVENT PHOTO ]</div>
            <div class="f-text"><h3>{f.name}</h3><p>{f.when}</p></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Gallery preview -->
  <section class="section card-bg">
    <div class="container stack">
      <div class="gallery-head">
        <h2 class="title">Gallery</h2>
        <a class="more" href="/gallery">View all →</a>
      </div>
      <div class="grid4">
        {[1, 2, 3, 4].map(() => <div class="ph r11">[ PHOTO ]</div>)}
      </div>
    </div>
  </section>

  <!-- Invite CTA -->
  <section class="section">
    <div class="container narrow stack centered" style="text-align:center">
      <h2 class="title">Invite Us to Sing</h2>
      <p class="lead">Parishes, priests and event organizers: we would be honored to serve your liturgy. Tell us about the occasion and we will respond as soon as we can.</p>
      <a class="btn btn-forest" href="/contact#invite" data-open-invite>Invite Us to Sing</a>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; overflow: hidden; background: var(--darkest-forest); color: var(--parchment); }
  /* Photo backdrop under a Darkest Forest scrim so parchment text stays readable. */
  .hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero::after {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(ellipse at 50% 40%, rgb(24 29 25 / 0.72) 0%, rgb(24 29 25 / 0.86) 60%, rgb(24 29 25 / 0.94) 100%);
  }
  .hero-inner { position: relative; z-index: 1; padding-top: 96px; padding-bottom: 72px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 22px; }
  .hero-crest { width: auto; height: 150px; }
  @media (max-width: 480px) { .hero-crest { height: 120px; } }
  .motto { font-family: var(--font-accent); font-style: italic; font-size: 20px; color: var(--antique-gold); }
  h1 { font-family: var(--font-display); font-weight: 700; font-size: clamp(34px, 8vw, 58px); line-height: 1.1; letter-spacing: 0.1em; color: var(--parchment); }
  .subtitle { font-family: var(--font-accent); font-style: italic; font-size: 24px; color: var(--muted-on-forest); }
  .headline { font-family: var(--font-accent); font-size: clamp(24px, 5vw, 30px); font-weight: 500; line-height: 1.3; max-width: 640px; }
  .positioning { font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; line-height: 1.9; max-width: 640px; color: var(--muted-on-forest); }
  .ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 16px; margin-top: 10px; }
  @media (max-width: 720px) { .hero-inner { padding-top: 64px; padding-bottom: 52px; } }
  @media (max-width: 480px) { .ctas .btn { flex: 1 1 100%; } }

  .engagements { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 20px; }
  .engagements li { flex: 1 1 300px; min-width: 0; display: flex; gap: 16px; align-items: center; background: var(--card-parchment); border: 1px solid var(--border-light); padding: 16px 18px; }
  .when { display: flex; flex-direction: column; align-items: center; min-width: 56px; border-right: 1px solid var(--border-light); padding-right: 16px; }
  .day { font-family: var(--font-display); font-size: 24px; font-weight: 700; color: var(--deep-forest); line-height: 1.2; }
  .month { font-size: 12px; letter-spacing: 0.1em; color: var(--deep-gold); }
  .what { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .occ { font-weight: 700; font-size: 15px; }
  .venue { font-size: 13px; color: var(--muted-on-parchment); }

  .about-row { display: flex; flex-wrap: wrap; gap: 48px; align-items: center; }
  .about-text { flex: 1 1 480px; min-width: 0; }
  .about-text p:not(.eyebrow) { font-size: 16px; line-height: 1.8; }
  .about-row > :global(.about-img) { flex: 1 1 380px; min-width: 0; aspect-ratio: 4 / 3; object-fit: cover; border: 1px solid var(--border-strong); }
  @media (max-width: 480px) { .about-text, .about-row > :global(.about-img) { flex-basis: 100%; } }

  .textured { position: relative; isolation: isolate; }
  .textured::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: var(--manuscript) center / 520px auto repeat; opacity: 0.08;
  }

  .repertoire { text-align: center; font-family: var(--font-accent); font-style: italic; font-size: 20px; color: var(--deep-gold); }

  .featured { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); gap: 28px; }
  .featured li { background: var(--card-parchment); border: 1px solid var(--border-light); display: flex; flex-direction: column; }
  .featured .ph { border: 0; border-bottom: 1px solid var(--border-strong); }
  .f-text { padding: 18px 20px; display: flex; flex-direction: column; gap: 4px; }
  .f-text h3 { font-family: var(--font-display); font-size: 18px; color: var(--deep-forest); }
  .f-text p { font-size: 14px; color: var(--muted-on-parchment); }

  .gallery-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 16px; }
  .gallery-head .more { margin-left: auto; }
  .grid4 { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  @media (max-width: 720px) { .grid4 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
