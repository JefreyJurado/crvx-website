---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import tlmImg from '../assets/images/ministry-tlm-cupola.jpg';
import noImg from '../assets/images/ministry-no-sunlit.jpg';
import { OCCASIONS } from '../data/site';

// Line icons for the occasions (same order as OCCASIONS), 24px grid, 1.5 stroke.
// No cross shapes (owner rule: the crest is the only cross on the site).
const ICONS = [
  'M6.5 3h11c0 5.5-2.5 8.5-5.5 8.5S6.5 8.5 6.5 3zM12 11.5v5M8 21h8M9 21c0-2.2 1.3-4.5 3-4.5s3 2.3 3 4.5', // chalice: ordinations
  'M10 10h4v11h-4zM12 10V8M12 3c1.6 1.8 1.6 3.4 0 5c-1.6-1.6-1.6-3.2 0-5z',          // candle: vows
  'M9 21C4.5 18 3 11.5 6.5 5M15 21c4.5-3 6-9.5 2.5-16M5.2 16.2c-2 .2-3.2-.8-3.8-2.3c1.6-.2 3 .6 3.8 2.3zM4.3 11.4c-1.9-.5-2.7-1.8-2.9-3.3c1.6.4 2.7 1.5 2.9 3.3zM5.6 7c-1.3-1-1.7-2.4-1.5-3.8c1.3.9 1.8 2.3 1.5 3.8zM18.8 16.2c2 .2 3.2-.8 3.8-2.3c-1.6-.2-3 .6-3.8 2.3zM19.7 11.4c1.9-.5 2.7-1.8 2.9-3.3c-1.6.4-2.7 1.5-2.9 3.3zM18.4 7c1.3-1 1.7-2.4 1.5-3.8c-1.3.9-1.8 2.3-1.5 3.8z', // laurel wreath: anniversaries
  'M14 13a5 5 0 1 1-10 0a5 5 0 0 1 10 0zM20 13a5 5 0 1 1-10 0a5 5 0 0 1 10 0z',      // two rings: nuptial Masses
  'M12 3l2.6 5.6 6.1.7-4.5 4.2 1.2 6L12 16.6 6.6 19.5l1.2-6L3.3 9.3l6.1-.7z',          // star: feast days
  'M9 18V5l11-2v13M9 18a3 3 0 1 1-6 0a3 3 0 0 1 6 0zM20 16a3 3 0 1 1-6 0a3 3 0 0 1 6 0z', // music note: concerts
  'M3 5h6a3 3 0 0 1 3 3v12a2 2 0 0 0-2-2H3zM21 5h-6a3 3 0 0 0-3 3v12a2 2 0 0 1 2-2h7z', // open book: other events
];
---
<Base title="Our Ministry" description="Crvx et Cithara sings at the Traditional Latin Mass and the Novus Ordo, and for ordinations, professions, anniversaries, nuptial Masses, feast days and concerts.">
  <section class="section dark page-head">
    <div class="container section-head centered">
      <p class="eyebrow">How we serve</p>
      <h1 class="title">Our Ministry</h1>
    </div>
  </section>

  <section class="section ruled">
    <div class="container narrow stack centered-all">
      <p class="eyebrow">Cantate Domino</p>
      <div class="prose">
        <p>For us, sacred music is not a performance set beside the liturgy. It is part of the liturgy itself: a prayer sung by the Church, offered to God and meant to lift the hearts of the faithful toward Him.</p>
        <p>Our choir serves in both the Traditional Latin Mass and the Novus Ordo, embracing the richness of the Church's musical heritage and the beauty of its liturgical traditions.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container row centered-all">
      <article class="card">
        <Image class="card-img" src={tlmImg} style="object-position: 50% 50%" alt="Gilded, frescoed side cupola of St. Peter's Basilica seen from directly below, framed by golden arches" widths={[400, 700, 1000]} sizes="(max-width: 860px) 100vw, 520px" format="webp" quality={72} />
        <h2 class="h3">Traditional Latin Mass</h2>
        <p>Gregorian chant and sacred polyphony sung for the usus antiquior, in continuity with centuries of the Church's liturgical music: the chant Propers of the day and a polyphonic or chant Ordinary.</p>
        <p class="todo">[ Where and how often the choir sings the Traditional Latin Mass: to be supplied by the choir. ]</p>
      </article>
      <article class="card">
        <Image class="card-img" src={noImg} style="object-position: 60% 40%" alt="Sunlight streaming into a gilded corner of St. Peter's Basilica, with a Latin inscription in gold" widths={[400, 700, 1000]} sizes="(max-width: 860px) 100vw, 520px" format="webp" quality={72} />
        <h2 class="h3">Novus Ordo</h2>
        <p>Traditional hymns, chant and liturgical music that elevate the ordinary form of the Mass, in parishes and for special celebrations.</p>
        <p class="todo">[ Where and how often the choir sings the Novus Ordo: to be supplied by the choir. ]</p>
      </article>
    </div>
  </section>

  <section class="section card-bg" aria-labelledby="occ-h">
    <div class="container stack lg">
      <div class="section-head centered">
        <h2 id="occ-h" class="title">Occasions We Sing For</h2>
      </div>
      <ul class="occasions">
        {OCCASIONS.map((o, i) => (
          <li>
            <svg class="occ-icon" viewBox="0 0 24 24" width="34" height="34" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d={ICONS[i]} /></svg>
            <span>{o}</span>
          </li>
        ))}
      </ul>
      <p class="repertoire">Our repertoire: Gregorian chant · sacred polyphony · traditional hymns</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow stack centered" style="text-align:center">
      <h2 class="title">Request the Choir for Your Liturgy</h2>
      <p class="lead">Tell us the date, the place and the occasion, and we will reply as soon as we can.</p>
      <a class="btn btn-forest" href="/contact#invite" data-open-invite>Invite Us to Sing</a>
    </div>
  </section>
</Base>

<style>
  .page-head { padding: 56px 0; }
  .card .h3 { font-family: var(--font-display); font-size: 20px; color: var(--deep-forest); }
  .card :global(.card-img) { width: calc(100% + 64px); max-width: none; margin: -32px -32px 8px; aspect-ratio: 4 / 3; object-fit: cover; }
  @media (max-width: 480px) { .card :global(.card-img) { width: calc(100% + 48px); margin: -24px -24px 8px; } }
  .todo { color: var(--deep-gold) !important; }
  /* Owner: centre everything on this page; cap paragraph width for reading. */
  .centered-all { text-align: center; }
  .centered-all .stack, .centered-all.stack { align-items: center; }
  .centered-all p { max-width: 55ch; margin-left: auto; margin-right: auto; }
  .centered-all .prose { align-items: center; }
  .centered-all .card { align-items: center; }

  /* Occasions: balanced rows (4 + 3 on desktop, 2 per row on tablets, 1 on
     phones), equal heights per row, gold top rule, lift + gold border on hover. */
  .occasions {
    list-style: none; margin: 0 auto; padding: 0; width: 100%; max-width: 1000px;
    display: flex; flex-wrap: wrap; justify-content: center; gap: 16px;
  }
  .occasions li {
    flex: 0 1 calc((100% - 48px) / 4); min-width: 200px; min-height: 132px;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px;
    text-align: center; padding: 22px 18px; font-size: 16px; line-height: 1.4; color: var(--deep-forest);
    background: var(--parchment); border: 1px solid var(--border-light); border-top: 2px solid var(--antique-gold);
    box-shadow: 0 1px 2px rgb(24 29 25 / 0.06);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .occasions li:hover { transform: translateY(-3px); border-color: var(--antique-gold); box-shadow: 0 8px 18px rgb(24 29 25 / 0.12); }
  .occ-icon { color: var(--deep-gold); flex: none; }
  @media (max-width: 900px) { .occasions li { flex-basis: calc((100% - 16px) / 2); } }
  @media (max-width: 480px) { .occasions li { flex-basis: 100%; min-height: 0; } }
  @media (prefers-reduced-motion: reduce) { .occasions li { transition: none; } .occasions li:hover { transform: none; } }
  .repertoire { text-align: center; font-family: var(--font-accent); font-style: italic; font-size: 20px; color: var(--deep-gold); }
</style>
