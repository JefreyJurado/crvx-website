---
import { NAV, SITE } from '../data/site';
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
---
<header class="site-header dark">
  <div class="container bar">
    <a href="/" class="brand" aria-label={`${SITE.name}, home`}>
      <!-- The official crest (source file kept in the docs folder, not in the repo). -->
      <img class="crest" src="/crest/crest-48.png" srcset="/crest/crest-48.png 1x, /crest/crest-96.png 2x" width="39" height="48" alt="" />
      <span class="brand-text">
        <span class="wordmark">{SITE.wordmark}</span>
        <span class="subtitle">{SITE.subtitle}</span>
      </span>
    </a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="main-nav">Menu</button>
    <nav id="main-nav" aria-label="Main">
      <ul>
        {NAV.map(n => (
          <li><a href={n.href} aria-current={path === n.href.split('#')[0] ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  // Sticky header: shadow once scrolled, and publish its height so anchor
  // links (scroll-padding-top) land below it.
  const header = document.querySelector<HTMLElement>('.site-header');
  if (header) {
    const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 4);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    const setH = () => document.documentElement.style.setProperty('--header-h', header.offsetHeight + 'px');
    setH();
    new ResizeObserver(setH).observe(header);
  }
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const nav = document.getElementById('main-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') !== 'true';
    btn.setAttribute('aria-expanded', String(open));
    nav?.classList.toggle('open', open);
  });
</script>

<style>
  /* Sticky on every page (owner). Solid Darkest Forest; a soft shadow once the
     page has scrolled. Stays in flow, so nothing below it moves. */
  .site-header {
    position: sticky; top: 0; z-index: 40;
    background: var(--darkest-forest); border-bottom: 1px solid var(--border-on-dark);
    transition: box-shadow 0.2s ease;
  }
  .site-header.scrolled { box-shadow: 0 4px 14px rgb(24 29 25 / 0.45); }
  @media (prefers-reduced-motion: reduce) { .site-header { transition: none; } }
  .bar { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px; padding-top: 14px; padding-bottom: 14px; }
  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; min-width: 0; }
  .crest { flex: none; width: auto; height: 48px; }
  .brand-text { display: flex; flex-direction: column; line-height: 1.15; }
  .wordmark { font-family: var(--font-display); font-weight: 600; font-size: 19px; letter-spacing: 0.14em; color: var(--parchment); }
  .subtitle { font-family: var(--font-accent); font-style: italic; font-size: 15px; color: var(--muted-on-forest); }
  nav { margin-left: auto; }
  nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 8px; }
  /* Menu items: padding is reserved at rest so the box never shifts layout.
     Hover / keyboard focus = filled Antique Gold box, Darkest Forest text
     (6.32:1). Current page = subtle gold outline box, parchment text. */
  nav a {
    display: inline-block; padding: 0.4em 0.9em; border-radius: 6px; border: 1px solid transparent;
    color: var(--muted-on-forest); text-decoration: none; font-size: 14px; letter-spacing: 0.06em;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  nav a[aria-current="page"] { color: var(--parchment); font-weight: 700; border-color: var(--antique-gold); background: rgb(180 154 104 / 0.12); }
  nav a:hover, nav a:focus-visible { background: var(--antique-gold); border-color: var(--antique-gold); color: var(--darkest-forest); }
  nav a:focus-visible { outline: 2px solid var(--antique-gold); outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) { nav a { transition: none; } }
  .menu-btn {
    display: none; margin-left: auto; min-height: 44px; padding: 0 16px;
    background: transparent; color: var(--parchment); border: 1px solid var(--border-on-dark);
    font: 700 14px var(--font-body); letter-spacing: 0.06em; cursor: pointer;
  }
  @media (max-width: 960px) {
    /* Without JS the menu stays open, so it is always reachable. */
    :global(.js) .menu-btn { display: inline-flex; align-items: center; }
    nav { flex-basis: 100%; margin-left: 0; }
    :global(.js) nav:not(.open) { display: none; }
    nav ul { flex-direction: column; gap: 0; border-top: 1px solid var(--border-on-dark-soft); }
    nav ul { padding: 8px 0; gap: 4px; }
    /* full-row tap target on phones */
    nav a { display: block; padding: 12px 14px; font-size: 16px; }
  }
  @media (max-width: 400px) {
    .wordmark { font-size: 16px; letter-spacing: 0.1em; }
    /* keep the Menu button on the brand's row at 360px */
    .bar { column-gap: 10px; }
    .brand { gap: 8px; }
    .crest { height: 42px; }
    .menu-btn { padding: 0 12px; }
  }
</style>
