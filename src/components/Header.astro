---
import { NAV, SITE } from '../data/site';
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
---
<header class="site-header dark">
  <div class="container bar">
    <a href="/" class="brand" aria-label={`${SITE.name}, home`}>
      <!-- The official crest (source file kept in the docs folder, not in the repo). -->
      <img class="crest" src="/crest/crest-48.png" srcset="/crest/crest-48.png 1x, /crest/crest-96.png 2x" width="39" height="48" alt="" />
      <span class="brand-text">
        <span class="wordmark">{SITE.wordmark}</span>
        <span class="subtitle">{SITE.subtitle}</span>
      </span>
    </a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="main-nav">Menu</button>
    <nav id="main-nav" aria-label="Main">
      <ul>
        {NAV.map(n => (
          <li><a href={n.href} aria-current={path === n.href.split('#')[0] ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const nav = document.getElementById('main-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') !== 'true';
    btn.setAttribute('aria-expanded', String(open));
    nav?.classList.toggle('open', open);
  });
</script>

<style>
  .site-header { background: var(--deep-forest); border-bottom: 1px solid var(--border-on-dark); }
  .bar { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px; padding-top: 14px; padding-bottom: 14px; }
  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; min-width: 0; }
  .crest { flex: none; width: auto; height: 48px; }
  .brand-text { display: flex; flex-direction: column; line-height: 1.15; }
  .wordmark { font-family: var(--font-display); font-weight: 600; font-size: 19px; letter-spacing: 0.14em; color: var(--parchment); }
  .subtitle { font-family: var(--font-accent); font-style: italic; font-size: 15px; color: var(--muted-on-forest); }
  nav { margin-left: auto; }
  nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 26px; }
  nav a {
    position: relative; color: var(--muted-on-forest); text-decoration: none;
    font-size: 14px; letter-spacing: 0.06em; padding: 10px 0; display: inline-block;
    transition: color 0.2s ease;
  }
  /* Antique Gold underline that grows from the centre: hover, keyboard focus,
     and (always shown) the current page. */
  nav a::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 4px; height: 2px;
    background: var(--antique-gold); transform: scaleX(0); transform-origin: center;
    transition: transform 0.25s ease;
  }
  nav a:hover, nav a:focus-visible { color: var(--antique-gold); }
  nav a:hover::after, nav a:focus-visible::after, nav a[aria-current="page"]::after { transform: scaleX(1); }
  nav a[aria-current="page"] { color: var(--parchment); font-weight: 700; }
  nav a:focus-visible { outline: 2px solid var(--antique-gold); outline-offset: 4px; }
  @media (prefers-reduced-motion: reduce) { nav a, nav a::after { transition: none; } }
  .menu-btn {
    display: none; margin-left: auto; min-height: 44px; padding: 0 16px;
    background: transparent; color: var(--parchment); border: 1px solid var(--border-on-dark);
    font: 700 14px var(--font-body); letter-spacing: 0.06em; cursor: pointer;
  }
  @media (max-width: 860px) {
    /* Without JS the menu stays open, so it is always reachable. */
    :global(.js) .menu-btn { display: inline-flex; align-items: center; }
    nav { flex-basis: 100%; margin-left: 0; }
    :global(.js) nav:not(.open) { display: none; }
    nav ul { flex-direction: column; gap: 0; border-top: 1px solid var(--border-on-dark-soft); }
    nav li { padding: 2px 0; }
    nav a { padding: 10px 0; font-size: 16px; }
  }
  @media (max-width: 400px) {
    .wordmark { font-size: 16px; letter-spacing: 0.1em; }
    /* keep the Menu button on the brand's row at 360px */
    .bar { column-gap: 10px; }
    .brand { gap: 8px; }
    .crest { height: 42px; }
    .menu-btn { padding: 0 12px; }
  }
</style>
