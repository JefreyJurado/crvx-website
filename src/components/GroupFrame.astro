---
// Wide group-photo frame in the same liturgical style as the member niches:
// a flattened round arch, a double Antique Gold border and a keystone dot,
// 16:9 (3:2 on phones), with an optional caption plate.
// Without `photo`, it shows a row of half-body silhouettes (preview demo only).
import { Image } from 'astro:assets';
import type { GroupPhoto } from '../data/members';
interface Props { photo?: GroupPhoto; caption?: string; }
const { photo, caption } = Astro.props;
// Back row then front row: [x, y, scale] in a 160×90 box (figure art is 80×100).
// Torso: back-row figures continue down behind the front row.
const FRONT = 'M8 100V84c0-12 9-21 21-23l6-1h10l6 1c12 2 21 11 21 23v16z';
const BACK = 'M8 220V84c0-12 9-21 21-23l6-1h10l6 1c12 2 21 11 21 23v136z';
const FIGURES = [[14, 16, 0.42], [50, 14, 0.42], [86, 14, 0.42], [122, 16, 0.42], [-4, 44, 0.5], [32, 42, 0.5], [68, 42, 0.5], [104, 42, 0.5], [140, 44, 0.5]];
---
<figure class="group">
  <div class="g-frame">
    {photo
      ? <Image class="g-img" src={photo.image} alt={photo.alt} widths={[640, 1000, 1400, 2000]} sizes="(max-width: 1100px) 100vw, 1000px" format="webp" quality={75} />
      : <svg class="g-img" viewBox="0 0 160 90" preserveAspectRatio="xMidYMid slice" role="img" aria-label="Sample group photo">
          <rect width="160" height="90" fill="var(--darkest-forest)" />
          {FIGURES.map(([x, y, s], i) => (
            <g transform={`translate(${x} ${y}) scale(${s})`}>
              {/* An opaque backing (with a thin dark outline) lets the front row cover the back row cleanly. */}
              <g fill="var(--darkest-forest)" stroke="var(--darkest-forest)" stroke-width="5">
                <circle cx="40" cy="36" r="14" />
                <path d={i < 4 ? BACK : FRONT} />
              </g>
              <g fill="var(--antique-gold)" fill-opacity={i < 4 ? 0.22 : 0.35}>
                <circle cx="40" cy="36" r="14" />
                <path d={i < 4 ? BACK : FRONT} />
              </g>
            </g>
          ))}
        </svg>}
  </div>
  {caption && <figcaption class="g-plate">{caption}</figcaption>}
</figure>

<style>
  .group { margin: 0 auto; width: 100%; display: flex; flex-direction: column; align-items: center; gap: 0; }
  .g-frame {
    --arch: 50% 50% 4px 4px / 14% 14% 4px 4px;
    position: relative; width: 100%; aspect-ratio: 16 / 9;
    padding: 5px; border: 1px solid var(--antique-gold); border-radius: var(--arch);
    background: var(--card-parchment); box-shadow: 0 6px 18px rgb(24 29 25 / 0.08);
  }
  .g-frame::before {
    content: ''; position: absolute; top: -4px; left: 50%; transform: translateX(-50%);
    width: 7px; height: 7px; border-radius: 50%; background: var(--antique-gold);
  }
  .g-frame > :global(.g-img) {
    display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%;
    border: 1px solid rgb(180 154 104 / 0.7); border-radius: var(--arch); overflow: hidden;
  }
  .g-plate {
    margin-top: -1px; padding: 6px 22px; border: 1px solid var(--antique-gold); border-top: 0;
    background: var(--card-parchment); border-radius: 0 0 4px 4px;
    font-family: var(--font-display); font-size: 14px; letter-spacing: 0.14em; color: var(--deep-forest);
  }
  @media (max-width: 520px) { .g-frame { aspect-ratio: 3 / 2; --arch: 50% 50% 4px 4px / 18% 18% 4px 4px; } }
</style>
