---
// Member portrait frame (owner: "a simple box, simple but liturgical").
// A square-cornered 4:5 box: parchment mat between a deep-gold outer rule and an
// antique-gold inner hairline. Photo crop rule unchanged (cover, 50% 22%). No ornament, no crosses.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Silhouette from './Silhouette.astro';
interface Props { photo?: ImageMetadata; alt?: string; sizes?: string; }
const { photo, alt = '', sizes = '240px' } = Astro.props;
---
<div class="niche">
  <div class="win">
    {photo ? <Image class="m-photo" src={photo} alt={alt} widths={[240, 480]} sizes={sizes} format="webp" quality={75} /> : <Silhouette />}
  </div>
</div>

<style>
  .niche {
    width: 100%; aspect-ratio: 4 / 5; flex: none; padding: 6px;
    background: var(--parchment); border: 1px solid var(--deep-gold);
  }
  .win { width: 100%; height: 100%; overflow: hidden; border: 1px solid var(--antique-gold); background: var(--darkest-forest); }
  .win > :global(*) { display: block; width: 100%; height: 100%; }
  .win > :global(.m-photo) { object-fit: cover; object-position: 50% 22%; }
</style>
