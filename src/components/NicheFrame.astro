---
// Liturgical portrait frame for member cards (owner's pick: the gilded icon).
// The photo/silhouette sits in a masked round-arched "window" under an inline SVG overlay:
// a wide gilt border with beads, a rosette 'glory' at the apex and corner rosettes.
// The window keeps the photo crop rule (cover, 50% 22%). No cross shapes.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Silhouette from './Silhouette.astro';
interface Props { photo?: ImageMetadata; alt?: string; sizes?: string; }
const { photo, alt = '', sizes = '240px' } = Astro.props;

// Rosette: a centre dot ringed by 8 petal dots (offset 22.5°, so no cross axes).
const rosette = (cx: number, cy: number, r: number) =>
  [`M${cx} ${cy}h0`, ...Array.from({ length: 8 }, (_, k) => {
    const a = (Math.PI / 180) * (22.5 + 45 * k);
    return `M${(cx + r * Math.cos(a)).toFixed(2)} ${(cy + r * Math.sin(a)).toFixed(2)}h0`;
  })].join('');

// viewBox 200×250. Window box: x 32–168, y 34–222.
const B_OUTER = 'M10 244V82A90 72 0 0 1 190 82V244Z';
const B_INNER = 'M32 222V88A68 54 0 0 1 168 88V222Z';
const B_MID = 'M21 233V85A79 63 0 0 1 179 85V233Z';
---
<div class="niche">
  <div class="v">
    <div class="win">
      {photo ? <Image class="m-photo" src={photo} alt={alt} widths={[240, 480]} sizes={sizes} format="webp" quality={75} /> : <Silhouette />}
    </div>
    <svg class="ovl" viewBox="0 0 200 250" aria-hidden="true" focusable="false">
      <!-- wide gilt border -->
      <path d={B_OUTER + B_INNER} fill="var(--antique-gold)" fill-opacity="0.32" fill-rule="evenodd" />
      <g fill="none" stroke="var(--antique-gold)">
        <path d={B_OUTER} stroke-width="1.6" />
        <path d={B_INNER} stroke-width="1.2" />
        <path d="M14 240V83A86 68 0 0 1 186 83V240Z" stroke-width="0.6" />
        <path d="M28 226V87A72 57 0 0 1 172 87V226Z" stroke-width="0.6" />
        <!-- bead-and-reel: beads on the mid line -->
        <path d={B_MID} stroke-width="3.4" stroke-linecap="round" stroke-dasharray="0 7.5" />
      </g>
      <!-- glory at the apex, rosettes at the springers and corners -->
      <g stroke="var(--antique-gold)" stroke-linecap="round" fill="none">
        <circle cx="100" cy="22" r="9.5" fill="var(--card-parchment)" stroke-width="1" />
        <path d={rosette(100, 22, 5.2)} stroke-width="3" />
        {[[21, 86], [179, 86], [21, 233], [179, 233]].map(([x, y]) => <>
          <circle cx={x} cy={y} r="7" fill="var(--card-parchment)" stroke-width="0.9" />
          <path d={rosette(x, y, 3.8)} stroke-width="2.2" />
        </>)}
      </g>
    </svg>
  </div>
</div>

<style>
  .niche { position: relative; width: 100%; aspect-ratio: 4 / 5; flex: none; }
  .v { position: absolute; inset: 0; }
  .win { position: absolute; overflow: hidden; background: var(--darkest-forest); }
  .win > :global(*) { display: block; width: 100%; height: 100%; }
  .win > :global(.m-photo) { object-fit: cover; object-position: 50% 22%; }
  .ovl { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; overflow: visible; }
  /* Window shape as a mask in the window's own box (scale with it). */
  .win {
    left: 16%; width: 68%; top: 13.6%; height: 75.2%;
    -webkit-mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 136 188' preserveAspectRatio='none'><path d='M0 188V54A68 54 0 0 1 136 54V188Z'/></svg>") 0 0 / 100% 100% no-repeat;
            mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 136 188' preserveAspectRatio='none'><path d='M0 188V54A68 54 0 0 1 136 54V188Z'/></svg>") 0 0 / 100% 100% no-repeat;
  }
</style>
