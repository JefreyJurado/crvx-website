---
// "Invite Us to Sing" popup (owner UX decision 2026-11-13). Any element with
// [data-open-invite] opens it. Those elements are links to /contact#invite,
// so without JavaScript they still reach the inline form.
import InviteForm from './InviteForm.astro';
---
<dialog id="invite-modal" aria-labelledby="invite-modal-title">
  <div class="panel">
    <button class="close" type="button" aria-label="Close" data-close-invite>×</button>
    <div class="head">
      <h2 id="invite-modal-title">Invite Us to Sing</h2>
      <p>Tell us about your celebration, and we will get back to you shortly.</p>
    </div>
    <InviteForm prefix="m" compact />
  </div>
</dialog>

<script>
  const dlg = document.getElementById('invite-modal') as HTMLDialogElement | null;
  if (dlg && typeof dlg.showModal === 'function') {
    document.querySelectorAll<HTMLElement>('[data-open-invite]').forEach(el =>
      el.addEventListener('click', e => { e.preventDefault(); dlg.showModal(); }));
    dlg.querySelector('[data-close-invite]')?.addEventListener('click', () => dlg.close());
    // A click on the backdrop (outside the panel) closes it.
    dlg.addEventListener('click', e => { if (e.target === dlg) dlg.close(); });
  }
</script>

<style>
  dialog {
    padding: 0; border: 1px solid var(--border-strong); background: var(--card-parchment); color: var(--charcoal);
    width: min(620px, calc(100% - 32px)); max-height: 88vh; overflow-y: auto;
  }
  dialog::backdrop { background: var(--scrim); }
  .panel { position: relative; padding: 32px; display: flex; flex-direction: column; gap: 18px; }
  .head { display: flex; flex-direction: column; gap: 6px; text-align: center; align-items: center; padding: 0 28px; }
  h2 { font-family: var(--font-display); font-size: 26px; color: var(--deep-forest); }
  .head p { font-size: 14px; line-height: 1.6; color: var(--muted-on-parchment); }
  .close {
    position: absolute; top: 8px; right: 8px; min-width: 44px; min-height: 44px;
    background: none; border: 0; cursor: pointer; font-size: 26px; line-height: 1; color: var(--deep-gold);
  }
  @media (max-width: 480px) { .panel { padding: 24px 16px; } h2 { font-size: 22px; } }
</style>
